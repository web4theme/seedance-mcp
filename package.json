{
  "name": "seedance-2-mcp",
  "version": "0.1.0",
  "description": "Local stdio MCP server for the Volcengine ARK Seedance 2.0 video generation API.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "seedance-2-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "seedance",
    "seedance-2",
    "video-generation",
    "volcengine",
    "ark",
    "doubao",
    "stdio"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seedance/seedance-2-mcp.git"
  }
}
